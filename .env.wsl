# Local Whisper STT Settings
# Models: TINY, BASE, SMALL, MEDIUM, LARGE, LARGE_V3_TURBO, DISTIL_MEDIUM_EN, DISTIL_LARGE_V2
WHISPER_MODEL=LARGE_V3_TURBO
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b

# Server Configuration
HOST=0.0.0.0
PORT=8765

# TensorRT Hybrid Mode - TRT for most models, ONNX for warp_network
DITTO_CONFIG_PATH=checkpoints/ditto_cfg/v0.4_hubert_cfg_hybrid.pkl
DITTO_CHECKPOINT_PATH=checkpoints/ditto_trt
DITTO_REALTIME=true
