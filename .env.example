# ==============================================================================
# TalkToMe Configuration
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# On WSL, the setup_wsl.sh script creates .env automatically.
# ==============================================================================

# --- API Keys -----------------------------------------------------------------
# Groq API key for cloud STT (speech-to-text). Get one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# --- Ollama LLM ---------------------------------------------------------------
# On Windows:  http://localhost:11434
# On WSL:      http://<windows-gateway-ip>:11434
#   (setup_wsl.sh auto-detects this; requires OLLAMA_HOST=0.0.0.0 on Windows)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b

# --- Ditto Video Generation ---------------------------------------------------
# Config presets (pick ONE):
#   PyTorch (no GPU accel):
#     DITTO_CONFIG_PATH=checkpoints/ditto_cfg/v0.4_hubert_cfg_pytorch.pkl
#     DITTO_CHECKPOINT_PATH=checkpoints/ditto_pytorch
#
#   TRT Hybrid (recommended for WSL - TRT + PyTorch warp):
#     DITTO_CONFIG_PATH=checkpoints/ditto_cfg/v0.4_hubert_cfg_trt_hybrid_online.pkl
#     DITTO_CHECKPOINT_PATH=checkpoints/ditto_trt
#
#   Full TensorRT (requires GridSample3D TRT plugin):
#     DITTO_CONFIG_PATH=checkpoints/ditto_cfg/v0.4_hubert_cfg_trt_online.pkl
#     DITTO_CHECKPOINT_PATH=checkpoints/ditto_trt
DITTO_CONFIG_PATH=checkpoints/ditto_cfg/v0.4_hubert_cfg_pytorch.pkl
DITTO_CHECKPOINT_PATH=checkpoints/ditto_pytorch
DITTO_REALTIME=true

# --- Server Settings ----------------------------------------------------------
HOST=0.0.0.0
PORT=8765
